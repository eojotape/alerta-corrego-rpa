<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_AlertaEnchentes" name="RPA - Alertas de enchente" isExecutable="false">
    <bpmn:startEvent id="s0" name="Início">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_sched" name="Gatilho agendado&#10;(a cada hora)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_csv" name="Ler e validar CSV&#10;de pontos">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_csv" name="CSV válido?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_sensor" name="Ler nível do sensor&#10;(Maker Lab)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_fatal" name="Encerra com erro&#10;(log CRITICAL)">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="sp" name="Para cada ponto monitorado (loop sequencial)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="i0" name="">
        <bpmn:outgoing>b1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="a_api" name="Consultar API&#10;Open-Meteo&#10;(retry + backoff)">
        <bpmn:incoming>b1</bpmn:incoming>
        <bpmn:outgoing>b2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="a_g1" name="API respondeu?">
        <bpmn:incoming>b2</bpmn:incoming>
        <bpmn:outgoing>b3</bpmn:outgoing>
        <bpmn:outgoing>b4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="a_val" name="Validar resposta&#10;(faixa e nulos)">
        <bpmn:incoming>b3</bpmn:incoming>
        <bpmn:outgoing>b5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="a_g2" name="Dados válidos?">
        <bpmn:incoming>b5</bpmn:incoming>
        <bpmn:outgoing>b6</bpmn:outgoing>
        <bpmn:outgoing>b7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="a_cls" name="Classificar risco&#10;(regra + sensor)">
        <bpmn:incoming>b6</bpmn:incoming>
        <bpmn:outgoing>b8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="a_g3" name="Nível NORMAL?">
        <bpmn:incoming>b8</bpmn:incoming>
        <bpmn:outgoing>b9</bpmn:outgoing>
        <bpmn:outgoing>b10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="a_g4" name="Alerta duplicado?">
        <bpmn:incoming>b10</bpmn:incoming>
        <bpmn:outgoing>b11</bpmn:outgoing>
        <bpmn:outgoing>b12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="a_not" name="Notificar&#10;(Telegram)">
        <bpmn:incoming>b12</bpmn:incoming>
        <bpmn:outgoing>b13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="a_sav" name="Gravar alerta&#10;no SQLite">
        <bpmn:incoming>b13</bpmn:incoming>
        <bpmn:outgoing>b14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="i1" name="Ponto concluído">
        <bpmn:incoming>b9</bpmn:incoming>
        <bpmn:incoming>b14</bpmn:incoming>
        <bpmn:incoming>b15</bpmn:incoming>
        <bpmn:incoming>b16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="a_fail" name="Registrar falha&#10;do ponto&#10;(lote continua)">
        <bpmn:incoming>b4</bpmn:incoming>
        <bpmn:incoming>b7</bpmn:incoming>
        <bpmn:outgoing>b15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="a_ign" name="Ignorar duplicado&#10;(log)">
        <bpmn:incoming>b11</bpmn:incoming>
        <bpmn:outgoing>b16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="b1" sourceRef="i0" targetRef="a_api" />
      <bpmn:sequenceFlow id="b2" sourceRef="a_api" targetRef="a_g1" />
      <bpmn:sequenceFlow id="b3" name="sim" sourceRef="a_g1" targetRef="a_val" />
      <bpmn:sequenceFlow id="b4" name="não" sourceRef="a_g1" targetRef="a_fail" />
      <bpmn:sequenceFlow id="b5" sourceRef="a_val" targetRef="a_g2" />
      <bpmn:sequenceFlow id="b6" name="sim" sourceRef="a_g2" targetRef="a_cls" />
      <bpmn:sequenceFlow id="b7" name="não" sourceRef="a_g2" targetRef="a_fail" />
      <bpmn:sequenceFlow id="b8" sourceRef="a_cls" targetRef="a_g3" />
      <bpmn:sequenceFlow id="b9" name="sim" sourceRef="a_g3" targetRef="i1" />
      <bpmn:sequenceFlow id="b10" name="não" sourceRef="a_g3" targetRef="a_g4" />
      <bpmn:sequenceFlow id="b11" name="sim" sourceRef="a_g4" targetRef="a_ign" />
      <bpmn:sequenceFlow id="b12" name="não" sourceRef="a_g4" targetRef="a_not" />
      <bpmn:sequenceFlow id="b13" sourceRef="a_not" targetRef="a_sav" />
      <bpmn:sequenceFlow id="b14" sourceRef="a_sav" targetRef="i1" />
      <bpmn:sequenceFlow id="b15" sourceRef="a_fail" targetRef="i1" />
      <bpmn:sequenceFlow id="b16" sourceRef="a_ign" targetRef="i1" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="t_exp" name="Exportar alertas&#10;em JSON">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_log" name="Registrar resumo&#10;da execução (log)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_api" name="API /alertas expõe&#10;os dados ao MVP">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e_end" name="Fim da execução">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s0" targetRef="t_sched" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_sched" targetRef="t_csv" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_csv" targetRef="g_csv" />
    <bpmn:sequenceFlow id="f4" name="sim" sourceRef="g_csv" targetRef="t_sensor" />
    <bpmn:sequenceFlow id="f5" name="não" sourceRef="g_csv" targetRef="e_fatal" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_sensor" targetRef="sp" />
    <bpmn:sequenceFlow id="f7" sourceRef="sp" targetRef="t_exp" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_exp" targetRef="t_log" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_log" targetRef="t_api" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_api" targetRef="e_end" />
  </bpmn:process>
